# ============================================
# SeaShop API — Environment Variables
# ============================================
# LOCAL DEV: cp .env.example .env rồi điền giá trị

# === App ===
PORT=3001
NODE_ENV=development

# === Database ===
# LOCAL (chạy docker-compose.infra.yml):
DATABASE_URL="postgresql://seashop:seashop_secret_change_me@localhost:6432/seashop_dev"
DATABASE_DIRECT_URL="postgresql://seashop:seashop_secret_change_me@localhost:5432/seashop_dev"

# PRODUCTION (Supabase — điền sau khi có project):
# DATABASE_URL="postgresql://postgres.xxxx:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres"
# DATABASE_DIRECT_URL="postgresql://postgres:[PASSWORD]@db.xxxx.supabase.co:5432/postgres"

# === JWT ===
JWT_SECRET=your_super_secret_jwt_key_change_in_production_minimum_32_chars
JWT_EXPIRES_IN=7d

# === Supabase Storage ===
# Lấy từ: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxxx
SUPABASE_SERVICE_KEY=sb_secret_xxxx

# === Pay2S Payment Gateway ===
PAY2S_IS_SANDBOX=true

# Production credentials (PAY2S Dashboard)
PAY2S_PARTNER_CODE=PAY2S1MJ9KMSA0XLAM6C
PAY2S_ACCESS_KEY=a641b1f928ba67b74a010566e62db93f6c1f2d70aa561bca40a921cb8e6a6689
PAY2S_SECRET_KEY=c544c53e44b5061746cb27c8b8fc1d0f0b29dbab0edbf0651b09ddac97a50a26

# Sandbox credentials
PAY2S_SANDBOX_PARTNER_CODE=PAY2S7EPF0SB1ZP27W71
PAY2S_SANDBOX_ACCESS_KEY=66e862c89d4d4d1f34063dc1967fbd64dece4da3cba90af65167fbb8503b2eb3
PAY2S_SANDBOX_SECRET_KEY=3cb0ba535605a7f1bad779d727bd234e8227073fc3f531b394524c2e4644ff97

# URL redirect về sau thanh toán
PAY2S_RETURN_URL=http://localhost:3000/payment/result

# URL webhook (PHẢI là HTTPS khi production)
# Local dev: để trống, sẽ dùng sandbox mock fallback
PAY2S_IPN_URL=

# Tên merchant
PAY2S_PARTNER_NAME=SeaShop

# Tài khoản ngân hàng nhận tiền (accountNumber|bankCode, phân cách bằng dấu phẩy)
# Ví dụ: 1234567890|VCB,9876543210|TCB
PAY2S_BANK_ACCOUNTS=
