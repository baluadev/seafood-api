# ============================================
# SeaShop API — Render Environment Variables
# ============================================
# Điền các giá trị này vào Render Dashboard:
# Dashboard → Service → Environment → Add Variable

# === Database (Supabase) ===
DATABASE_URL=postgresql://postgres.xxxx:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
DATABASE_DIRECT_URL=postgresql://postgres:[PASSWORD]@db.xxxx.supabase.co:5432/postgres

# === App ===
PORT=3001
NODE_ENV=production

# === JWT (generate: openssl rand -base64 64) ===
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_STRING
JWT_EXPIRES_IN=7d

# === Supabase Storage ===
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxxx
SUPABASE_SERVICE_KEY=sb_secret_xxxx

# === Pay2S (Production) ===
PAY2S_IS_SANDBOX=false
PAY2S_PARTNER_CODE=PAY2S1MJ9KMSA0XLAM6C
PAY2S_ACCESS_KEY=REPLACE_WITH_PRODUCTION_ACCESS_KEY
PAY2S_SECRET_KEY=REPLACE_WITH_PRODUCTION_SECRET_KEY
PAY2S_RETURN_URL=https://REPLACE_WITH_VERCEL_DOMAIN/payment/result
PAY2S_IPN_URL=https://REPLACE_WITH_RENDER_DOMAIN/api/v1/payment/pay2s/webhook
PAY2S_PARTNER_NAME=SeaShop
PAY2S_BANK_ACCOUNTS=ACCOUNT_NUMBER|BANK_CODE
