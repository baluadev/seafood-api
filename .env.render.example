# ============================================
# SeaShop API — Render Environment Variables
# ============================================
# Điền các giá trị này vào Render Dashboard:
# Service → Environment → Add Environment Variable

# === Database (Supabase) ===
# Lấy từ: Supabase → Settings → Database → Connect → Transaction pooler
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1

# Lấy từ: Supabase → Settings → Database → Connect → Session pooler (port 5432)
DATABASE_DIRECT_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres

# === App ===
PORT=3001
NODE_ENV=production

# === JWT (generate: openssl rand -base64 64) ===
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_STRING
JWT_EXPIRES_IN=7d

# === Supabase Storage ===
# Lấy từ: Supabase → Settings → API
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxxx
SUPABASE_SERVICE_KEY=sb_secret_xxxx

# === Pay2S ===
PAY2S_IS_SANDBOX=true
PAY2S_PARTNER_CODE=REPLACE_WITH_PARTNER_CODE
PAY2S_ACCESS_KEY=REPLACE_WITH_ACCESS_KEY
PAY2S_SECRET_KEY=REPLACE_WITH_SECRET_KEY
PAY2S_SANDBOX_PARTNER_CODE=REPLACE_WITH_SANDBOX_PARTNER_CODE
PAY2S_SANDBOX_ACCESS_KEY=REPLACE_WITH_SANDBOX_ACCESS_KEY
PAY2S_SANDBOX_SECRET_KEY=REPLACE_WITH_SANDBOX_SECRET_KEY

# Điền sau khi deploy Vercel dashboard
PAY2S_RETURN_URL=https://REPLACE_WITH_VERCEL_DASHBOARD_URL/payment/result

# Điền sau khi có URL từ Render
PAY2S_IPN_URL=https://REPLACE_WITH_RENDER_API_URL/api/v1/payment/pay2s/webhook

PAY2S_PARTNER_NAME=SeaShop
PAY2S_BANK_ACCOUNTS=
